{
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/apiext-mediakit.db"
  },
  "MediaKit": {
    "DefaultServer": {
      "Name": "Local ZLMediaKit",
      "BaseUrl": "http://127.0.0.1:8080",
      "Secret": ""
    },
    "WebhookSecret": "change-webhook-secret",
    "StreamAuth": {
      "Enabled": true,
      "TokenTtlMinutes": 60,
      "SigningKey": "change-stream-auth-key",
      "AllowEmptyTokenInDevelopment": true
    },
    "Security": {
      "BlockWeakAdminPassword": false,
      "WeakPasswords": [ "change-me", "admin", "password", "123456", "" ]
    },
    "Webhook": {
      "AllowedIps": [],
      "RateLimitPerMinute": 120
    },
    "PlayUrl": {
      "PublicHost": null,
      "HttpPort": null,
      "HttpsPort": null,
      "RtspPort": 554,
      "RtmpPort": 1935,
      "ForceHttps": false,
      "IncludeCustomVhostInPath": false
    },
    "Health": {
      "ProbeDefaultZlm": true,
      "ProbeTimeoutSeconds": 3
    }
  },
  "Authentication": {
    "UserName": "admin",
    "Password": "change-me",
    "DisplayName": "系统管理员"
  },
  "ProSettings": {
    "Title": "Apiext.MediaKit",
    "NavTheme": "light",
    "Layout": "side",
    "ContentWidth": "Fluid",
    "FixedHeader": true,
    "FixSiderbar": true,
    "ColorWeak": false,
    "PrimaryColor": "daybreak"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
