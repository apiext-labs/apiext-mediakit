@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Apiext.MediaKit.Server.Components.Layout.BasicLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Apiext.MediaKit.Server.Components.Layout.BasicLayout)">
            <p>页面不存在</p>
        </LayoutView>
    </NotFound>
</Router>

<AntContainer />
