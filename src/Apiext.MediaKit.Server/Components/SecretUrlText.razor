@namespace Apiext.MediaKit.Server.Components
@* 敏感连接地址（rtsp:// 等常带账号密码）：默认掩码，点眼睛图标切换明文/掩码 *@
@if (string.IsNullOrWhiteSpace(Value))
{
    <span style="color:#9aa5b1;">-</span>
}
else
{
    <span style="word-break:break-all;">@(_visible ? Value : Mask(Value!))</span>
    <Tooltip Title="@(_visible ? "隐藏" : "显示")">
        <Button Type="@ButtonType.Link" Size="@ButtonSize.Small"
                Icon="@(_visible ? "eye-invisible" : "eye")"
                OnClick="@(() => _visible = !_visible)" />
    </Tooltip>
}

@code {
    /// <summary>要展示的原始地址。</summary>
    [Parameter] public string? Value { get; set; }

    private bool _visible;

    /// <summary>只保留协议头（rtsp:// 等），其余掩掉，避免泄露账号密码与源地址。</summary>
    private static string Mask(string url)
    {
        var idx = url.IndexOf("://", StringComparison.Ordinal);
        return idx > 0 ? url[..(idx + 3)] + "••••••••" : "••••••••";
    }
}
