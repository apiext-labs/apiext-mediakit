@namespace Apiext.MediaKit.Components
@inject MediaServerContext ServerContext
@implements IDisposable

<div class="page-toolbar">
    <select class="server-select" value="@(_serverId?.ToString() ?? "")" @onchange="OnChangedAsync">
        @if (ServerContext.Servers.Count == 0)
        {
            <option value="">暂无媒体实例</option>
        }
        else
        {
            @foreach (var server in ServerContext.Servers)
            {
                <option value="@server.Id">@server.Name</option>
            }
        }
    </select>
    @ChildContent
</div>

@code {
    private Guid? _serverId;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnServerChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ServerContext.Changed += OnContextChanged;
        await ServerContext.EnsureLoadedAsync();
        _serverId = ServerContext.CurrentServerId;
    }

    private void OnContextChanged()
    {
        _ = InvokeAsync(async () =>
        {
            _serverId = ServerContext.CurrentServerId;
            StateHasChanged();
            if (OnServerChanged.HasDelegate) await OnServerChanged.InvokeAsync();
        });
    }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var id = Guid.TryParse(args.Value?.ToString(), out var value) ? value : (Guid?)null;
        await ServerContext.SetCurrentAsync(id);
        _serverId = ServerContext.CurrentServerId;
        if (OnServerChanged.HasDelegate) await OnServerChanged.InvokeAsync();
    }

    public void Dispose() => ServerContext.Changed -= OnContextChanged;
}
