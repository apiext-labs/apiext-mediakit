@namespace Apiext.MediaKit.Pages.User
@attribute [AllowAnonymous]
@layout UserLayout
@page "/user/login"

<div class="auth-panel">
    <header>
        <h1>管理员登录</h1>
        <p>使用配置中的管理账户进入控制台</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <Alert Type="@AlertType.Error" ShowIcon="true" Message="@Error" Style="margin-bottom:20px" />
    }

    @* Real browser form POST — only a browser response can Set-Cookie under Interactive Server. *@
    <form method="post" action="/api/auth/login-form" class="auth-form" autocomplete="on">
        <input type="hidden" name="returnUrl" value="@(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl)" />

        <div class="auth-field">
            <label for="userName">用户名</label>
            <input id="userName" name="userName" type="text" autocomplete="username" placeholder="管理员用户名" required value="@UserName" />
        </div>
        <div class="auth-field">
            <label for="password">密码</label>
            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="密码" required />
        </div>
        <div class="auth-options">
            <label class="auth-check">
                <input type="checkbox" name="autoLogin" value="true" />
                <span>保持登录</span>
            </label>
        </div>
        <button type="submit" class="auth-submit">登录</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "userName")] public string? UserName { get; set; }
}
