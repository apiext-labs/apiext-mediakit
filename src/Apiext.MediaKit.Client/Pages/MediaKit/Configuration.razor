@page "/configuration"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MediaServerContext ServerContext
@inject MessageService Message

<PageContainer Title="ZLM 配置">
    <ExtraContent>
        <ServerSelector OnServerChanged="LoadAsync">
            <Button Icon="reload" Loading="_loading" OnClick="LoadAsync">重新读取</Button>
            <Button Type="@ButtonType.Primary" Icon="save" Loading="_saving" OnClick="SaveAsync">保存修改</Button>
        </ServerSelector>
    </ExtraContent>
    <Content>直接读取并修改 ZLMediaKit 的运行配置。部分配置需重启 ZLM 才会生效。</Content>
    <ChildContent>
        <Card BodyStyle="padding:0">
            <Table DataSource="@_entries" Loading="_loading" PageSize="30" ScrollX="900" TItem="ConfigurationEntryDto">
                <AntDesign.Column Title="配置键" @bind-Field="@context.Key" Width="360" />
                <AntDesign.Column TData="ConfigurationEntryDto" Title="值"><Input @bind-Value="context.Value" /></AntDesign.Column>
            </Table>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<ConfigurationEntryDto> _entries = [];
    private bool _loading;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await ServerContext.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await ServerContext.EnsureLoadedAsync();
            _entries = await Api.GetConfigurationAsync(ServerContext.CurrentServerId);
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        if (ServerContext.CurrentServerId is null) return;
        _saving = true;
        try
        {
            await Api.SaveConfigurationAsync(new(ServerContext.CurrentServerId.Value, _entries.ToDictionary(x => x.Key, x => x.Value)));
            Message.Success("配置已提交");
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _saving = false; }
    }
}
