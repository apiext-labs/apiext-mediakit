@page "/recordings"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MediaServerContext ServerContext
@inject MessageService Message

<PageContainer Title="录制管理">
    <ExtraContent>
        <ServerSelector OnServerChanged="OnServerChangedAsync">
            <Button Icon="reload" Loading="_loadingStreams" OnClick="LoadStreamsAsync">刷新在线流</Button>
        </ServerSelector>
    </ExtraContent>
    <ChildContent>
        <Card Title="录制控制" Style="margin-bottom:16px">
            <div class="form-grid">
                <div>
                    <label class="field-label">在线流（可选）</label>
                    <select class="server-select" @onchange="OnStreamPicked">
                        <option value="">手动填写</option>
                        @foreach (var s in _streams)
                        {
                            <option value="@($"{s.Vhost}|{s.App}|{s.Stream}")">@s.App / @s.Stream (@s.Schema)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="field-label">录制类型</label>
                    <RadioGroup @bind-Value="_type"><Radio Value="1">MP4</Radio><Radio Value="0">HLS</Radio></RadioGroup>
                </div>
                <div><label class="field-label">VHost</label><Input @bind-Value="_vhost" /></div>
                <div><label class="field-label">应用</label><Input @bind-Value="_app" /></div>
                <div class="wide"><label class="field-label">流 ID</label><Input @bind-Value="_stream" Placeholder="请输入在线流 ID" /></div>
                <div>
                    <label class="field-label">检索日期</label>
                    <Input @bind-Value="_period" Placeholder="yyyy-MM-dd 或 yyyy-MM" />
                </div>
                <div class="wide">
                    <Space>
                        <SpaceItem><Button Type="@ButtonType.Primary" Icon="play-circle" Loading="_saving" OnClick="@(() => OperateAsync(true))">开始录制</Button></SpaceItem>
                        <SpaceItem><Button Danger Icon="stop" Loading="_saving" OnClick="@(() => OperateAsync(false))">停止录制</Button></SpaceItem>
                        <SpaceItem><Button Icon="search" Loading="_loadingFiles" OnClick="SearchAsync">检索录像</Button></SpaceItem>
                    </Space>
                </div>
            </div>
        </Card>

        <Card Title="录像文件" BodyStyle="padding:0">
            <div style="padding:12px 16px;color:rgba(0,0,0,.45)">根目录：@_recordRoot · 共 @_files.Count 个文件</div>
            <Table DataSource="@_files" Loading="_loadingFiles" PageSize="15" TItem="RecordFileDto">
                <AntDesign.Column Title="文件名" @bind-Field="@context.FileName" />
                <AntDesign.Column Title="路径" @bind-Field="@context.FilePath" />
                <ActionColumn Title="操作" Width="180">
                    <Space>
                        <SpaceItem>
                            @if (!string.IsNullOrWhiteSpace(context.PlayUrl))
                            {
                                <a href="@context.PlayUrl" target="_blank">播放/下载</a>
                            }
                            else { <span>-</span> }
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </Card>
        <Alert Type="AlertType.Info" ShowIcon="true" Style="margin-top:16px"
               Message="录像由 ZLMediaKit 落盘"
               Description="本页发起 start/stopRecord，并调用 getMp4RecordFile 检索；播放链接走 ZLM downloadFile（含 secret，仅管理员会话可见）。" />
    </ChildContent>
</PageContainer>

@code {
    private List<MediaStreamDto> _streams = [];
    private List<RecordFileDto> _files = [];
    private int _type = 1;
    private string _vhost = "__defaultVhost__";
    private string _app = "live";
    private string _stream = string.Empty;
    private string _period = DateTime.Today.ToString("yyyy-MM-dd");
    private string _recordRoot = "-";
    private bool _saving;
    private bool _loadingFiles;
    private bool _loadingStreams;

    protected override async Task OnInitializedAsync()
    {
        await ServerContext.EnsureLoadedAsync();
        await LoadStreamsAsync();
    }

    private async Task OnServerChangedAsync()
    {
        await LoadStreamsAsync();
        _files = [];
        _recordRoot = "-";
    }

    private async Task LoadStreamsAsync()
    {
        _loadingStreams = true;
        try
        {
            await ServerContext.EnsureLoadedAsync();
            _streams = await Api.GetStreamsAsync(ServerContext.CurrentServerId);
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _loadingStreams = false; }
    }

    private void OnStreamPicked(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(raw)) return;
        var parts = raw.Split('|');
        if (parts.Length != 3) return;
        _vhost = parts[0];
        _app = parts[1];
        _stream = parts[2];
    }

    private async Task OperateAsync(bool start)
    {
        if (ServerContext.CurrentServerId is null) { Message.Warning("请先选择媒体实例"); return; }
        if (string.IsNullOrWhiteSpace(_stream)) { Message.Warning("请输入流 ID"); return; }
        _saving = true;
        try
        {
            var request = new RecordOperationRequest(ServerContext.CurrentServerId.Value, _vhost, _app, _stream, _type);
            if (start) await Api.StartRecordAsync(request);
            else await Api.StopRecordAsync(request);
            Message.Success(start ? "已开始录制" : "已停止录制");
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _saving = false; }
    }

    private async Task SearchAsync()
    {
        if (ServerContext.CurrentServerId is null) { Message.Warning("请先选择媒体实例"); return; }
        if (string.IsNullOrWhiteSpace(_stream)) { Message.Warning("请输入流 ID"); return; }
        _loadingFiles = true;
        try
        {
            var result = await Api.GetRecordFilesAsync(ServerContext.CurrentServerId.Value, _vhost, _app, _stream, _period);
            _recordRoot = result?.RootPath is { Length: > 0 } r ? r : "-";
            _files = result?.Files?.Count > 0
                ? result.Files
                : (result?.Paths ?? []).Select(p => new RecordFileDto
                {
                    FileName = p.Replace('\\', '/').Split('/').LastOrDefault() ?? p,
                    FilePath = p
                }).ToList();
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _loadingFiles = false; }
    }
}
