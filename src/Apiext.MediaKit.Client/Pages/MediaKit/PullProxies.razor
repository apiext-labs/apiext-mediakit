@page "/pull-proxies"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MediaServerContext ServerContext
@inject MessageService Message

<PageContainer Title="拉流代理">
    <ExtraContent>
        <ServerSelector OnServerChanged="LoadAsync">
            <Button Icon="reload" Loading="_loading" OnClick="LoadAsync">刷新</Button>
        </ServerSelector>
    </ExtraContent>
    <ChildContent>
        <Card Title="@(_editingId.HasValue ? "编辑代理" : "新建代理")" Style="margin-bottom:16px">
            <div class="form-grid">
                <div>
                    <label class="field-label">媒体实例</label>
                    <select class="server-select" @bind="_request.MediaServerId" disabled="@_editingId.HasValue">
                        @foreach (var server in ServerContext.Servers)
                        {
                            <option value="@server.Id">@server.Name</option>
                        }
                    </select>
                </div>
                <div class="wide">
                    <label class="field-label">源地址（每行一个，按顺序优先）</label>
                    <TextArea @bind-Value="_sourceUrlsText" Rows="3" Placeholder="rtsp://主地址&#10;rtsp://备用地址" />
                </div>
                <div><label class="field-label">VHost</label><Input @bind-Value="_request.Vhost" Disabled="@_editingId.HasValue" /></div>
                <div>
                    <label class="field-label">应用 / 流 ID</label>
                    <InputGroup Compact>
                        <Input Style="width:40%" @bind-Value="_request.App" Disabled="@_editingId.HasValue" />
                        <Input Style="width:60%" @bind-Value="_request.Stream" Disabled="@_editingId.HasValue" />
                    </InputGroup>
                </div>
                <div>
                    <label class="field-label">转协议预设</label>
                    <select class="server-select" value="@(_request.ProtocolPresetId?.ToString() ?? "")" @onchange="OnPresetChanged">
                        <option value="">服务器默认</option>
                        @foreach (var preset in _presets)
                        {
                            <option value="@preset.Id">@preset.Name</option>
                        }
                    </select>
                </div>
                <div><label class="field-label">备注</label><Input @bind-Value="_request.Remark" /></div>
                <div>
                    <label class="field-label">重试 / 超时（秒）</label>
                    <InputGroup Compact>
                        <AntDesign.InputNumber Style="width:50%" @bind-Value="_request.RetryCount" />
                        <AntDesign.InputNumber Style="width:50%" @bind-Value="_request.TimeoutSeconds" Min="1" />
                    </InputGroup>
                </div>
                <div>
                    <label class="field-label">RTSP 拉流方式</label>
                    <RadioGroup @bind-Value="_request.RtpType">
                        <Radio Value="0">TCP</Radio>
                        <Radio Value="1">UDP</Radio>
                        <Radio Value="2">组播</Radio>
                    </RadioGroup>
                </div>
                <div class="wide">
                    <Space>
                        <SpaceItem><Checkbox @bind-Checked="_request.OnDemand">按需拉流</Checkbox></SpaceItem>
                        <SpaceItem><Checkbox @bind-Checked="_request.EnableHls">HLS</Checkbox></SpaceItem>
                        <SpaceItem><Checkbox @bind-Checked="_request.EnableMp4">MP4 录制</Checkbox></SpaceItem>
                        <SpaceItem>
                            <Button Type="@ButtonType.Primary" Icon="@(_editingId.HasValue ? "save" : "plus")" Loading="_saving" OnClick="SaveAsync">
                                @(_editingId.HasValue ? "保存修改" : "创建代理")
                            </Button>
                        </SpaceItem>
                        @if (_editingId.HasValue)
                        {
                            <SpaceItem><Button OnClick="CancelEdit">取消编辑</Button></SpaceItem>
                        }
                    </Space>
                </div>
            </div>
        </Card>
        <Card BodyStyle="padding:0">
            <Table DataSource="@_proxies" Loading="_loading" PageSize="15" ScrollX="1200" TItem="PullProxyDto">
                <AntDesign.Column Title="VHost" @bind-Field="@context.Vhost" Width="140" />
                <AntDesign.Column Title="应用" @bind-Field="@context.App" Width="100" />
                <AntDesign.Column Title="流 ID" @bind-Field="@context.Stream" Width="150" />
                <AntDesign.Column Title="源地址" @bind-Field="@context.SourceUrl" Width="280" />
                <AntDesign.Column Title="备注" @bind-Field="@context.Remark" Width="120" />
                <AntDesign.Column TData="PullProxyDto" Title="模式" Width="90">
                    <Tag Color="@(context.OnDemand ? "blue" : "green")">@(context.OnDemand ? "按需" : "立即")</Tag>
                </AntDesign.Column>
                <AntDesign.Column Title="运行" @bind-Field="@context.IsActive" Width="80" />
                <ActionColumn Title="操作" Width="280">
                    <Space>
                        <SpaceItem><Button Type="@ButtonType.Link" OnClick="@(() => BeginEdit(context))">编辑</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" OnClick="@(() => ToggleAsync(context.Id))">切换模式</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" Disabled="@(!context.IsActive)" OnClick="@(() => StopAsync(context.Id))">停止</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" Danger OnClick="@(() => DeleteAsync(context.Id))">删除</Button></SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<PullProxyDto> _proxies = [];
    private List<ProtocolPresetDto> _presets = [];
    private CreatePullProxyRequest _request = new();
    private string _sourceUrlsText = string.Empty;
    private Guid? _editingId;
    private bool _loading;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await ServerContext.EnsureLoadedAsync();
        _presets = await Api.GetProtocolPresetsAsync();
        ResetForm();
        await LoadAsync();
    }

    private void ResetForm()
    {
        _editingId = null;
        _request = new CreatePullProxyRequest
        {
            MediaServerId = ServerContext.CurrentServerId ?? Guid.Empty,
            Vhost = "__defaultVhost__",
            App = "live",
            EnableHls = true,
            RetryCount = -1,
            TimeoutSeconds = 10
        };
        _sourceUrlsText = string.Empty;
    }

    private void BeginEdit(PullProxyDto proxy)
    {
        _editingId = proxy.Id;
        _request = new CreatePullProxyRequest
        {
            MediaServerId = proxy.MediaServerId,
            Vhost = proxy.Vhost,
            App = proxy.App,
            Stream = proxy.Stream,
            SourceUrls = proxy.SourceUrls?.Count > 0 ? proxy.SourceUrls : [proxy.SourceUrl],
            Remark = proxy.Remark,
            ProtocolPresetId = proxy.ProtocolPresetId,
            OnDemand = proxy.OnDemand,
            RetryCount = proxy.RetryCount,
            TimeoutSeconds = proxy.TimeoutSeconds,
            RtpType = proxy.RtpType,
            EnableHls = proxy.EnableHls,
            EnableMp4 = proxy.EnableMp4
        };
        _sourceUrlsText = string.Join(Environment.NewLine, _request.SourceUrls);
    }

    private void CancelEdit() => ResetForm();

    private void OnPresetChanged(ChangeEventArgs args)
    {
        _request.ProtocolPresetId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await ServerContext.EnsureLoadedAsync();
            if (!_editingId.HasValue)
                _request.MediaServerId = ServerContext.CurrentServerId ?? _request.MediaServerId;
            _proxies = await Api.GetPullProxiesAsync(ServerContext.CurrentServerId);
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        _request.SourceUrls = _sourceUrlsText
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
        _saving = true;
        try
        {
            if (_editingId.HasValue)
            {
                await Api.UpdatePullProxyAsync(_editingId.Value, _request);
                Message.Success("代理已更新");
            }
            else
            {
                if (_request.MediaServerId == Guid.Empty)
                    _request.MediaServerId = ServerContext.CurrentServerId ?? Guid.Empty;
                await Api.CreatePullProxyAsync(_request);
                Message.Success(_request.OnDemand ? "按需代理已保存" : "拉流代理已启动");
            }
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _saving = false; }
    }

    private async Task StopAsync(Guid id)
    {
        try { await Api.StopPullProxyAsync(id); Message.Success("代理已停止"); await LoadAsync(); }
        catch (Exception ex) { Message.Error(ex.Message); }
    }

    private async Task ToggleAsync(Guid id)
    {
        try { await Api.TogglePullProxyModeAsync(id); Message.Success("代理模式已切换"); await LoadAsync(); }
        catch (Exception ex) { Message.Error(ex.Message); }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await Api.DeletePullProxyAsync(id);
            Message.Success("代理配置已删除");
            if (_editingId == id) ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { Message.Error(ex.Message); }
    }
}
