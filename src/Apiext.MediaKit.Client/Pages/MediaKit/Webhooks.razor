@page "/webhooks"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MessageService Message

<PageContainer Title="Webhook 事件">
    <ExtraContent>
        <div class="page-toolbar">
            <Input Placeholder="过滤事件名" Style="width:200px" @bind-Value="_filter" />
            <Button Icon="reload" Loading="_loading" OnClick="LoadAsync">刷新</Button>
        </div>
    </ExtraContent>
    <Content>
        回调地址：
        <Text Code>http://管理平台/api/mediakit/webhooks/on_play?serverId=实例ID&amp;secret=你的WebhookSecret</Text>
        。请在 ZLM hook 配置中带上 secret。
    </Content>
    <ChildContent>
        <Card BodyStyle="padding:0">
            <Table DataSource="@Filtered" Loading="_loading" PageSize="20" ScrollX="1200" TItem="WebhookEventDto">
                <AntDesign.Column Title="时间(UTC)" @bind-Field="@context.ReceivedAt" Width="190" />
                <AntDesign.Column Title="事件" @bind-Field="@context.EventName" Width="180" />
                <AntDesign.Column Title="VHost" @bind-Field="@context.Vhost" Width="140" />
                <AntDesign.Column Title="应用" @bind-Field="@context.App" Width="100" />
                <AntDesign.Column Title="流 ID" @bind-Field="@context.Stream" Width="140" />
                <AntDesign.Column TData="WebhookEventDto" Title="原始载荷">
                    <div class="payload" title="@context.Payload">@context.Payload</div>
                </AntDesign.Column>
            </Table>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<WebhookEventDto> _events = [];
    private bool _loading;
    private string _filter = string.Empty;

    private IEnumerable<WebhookEventDto> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _events
            : _events.Where(x => x.EventName.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                                 || (x.Stream?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)
                                 || (x.App?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try { _events = await Api.GetWebhooksAsync(); }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _loading = false; }
    }
}
