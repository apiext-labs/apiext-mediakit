@page "/streams"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MediaServerContext ServerContext
@inject MessageService Message
@inject IJSRuntime Js

<PageContainer Title="在线流">
    <ExtraContent>
        <ServerSelector OnServerChanged="LoadAsync">
            <Input Placeholder="搜索 app / stream / 协议" Style="width:220px" @bind-Value="_keyword" />
            <Button Icon="reload" Loading="_loading" OnClick="LoadAsync">刷新</Button>
        </ServerSelector>
    </ExtraContent>
    <ChildContent>
        <Card BodyStyle="padding:0">
            <Table DataSource="@FilteredStreams" Loading="_loading" PageSize="15" ScrollX="1300" TItem="MediaStreamDto">
                <AntDesign.Column Title="协议" @bind-Field="@context.Schema" Width="90" />
                <AntDesign.Column Title="VHost" @bind-Field="@context.Vhost" Width="140" />
                <AntDesign.Column Title="应用" @bind-Field="@context.App" Width="110" />
                <AntDesign.Column Title="流 ID" @bind-Field="@context.Stream" Width="160" />
                <AntDesign.Column Title="来源" @bind-Field="@context.OriginTypeStr" Width="120" />
                <AntDesign.Column Title="观看" @bind-Field="@context.ReaderCount" Width="80" />
                <AntDesign.Column Title="速度(B/s)" @bind-Field="@context.BytesSpeed" Width="110" />
                <AntDesign.Column TData="MediaStreamDto" Title="录制" Width="100">
                    @if (context.IsRecordingMp4 || context.IsRecordingHls)
                    {
                        <Tag Color="@("red")">@(context.IsRecordingMp4 ? "MP4" : "") @(context.IsRecordingHls ? "HLS" : "")</Tag>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </AntDesign.Column>
                <ActionColumn Title="操作" Width="260">
                    <Space>
                        <SpaceItem><Button Type="@ButtonType.Link" OnClick="@(() => OpenPlayAsync(context))">播放</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" OnClick="@(() => OpenViewersAsync(context))">观众</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" OnClick="@(() => OpenSnapAsync(context))">截图</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" Danger OnClick="@(() => CloseAsync(context))">关闭</Button></SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </Card>

        <Modal Title="@_playTitle" Visible="_playVisible" Width="820" Footer="null" OnCancel="ClosePlayAsync" DestroyOnClose>
            @if (_playInfo is not null)
            {
                <div class="player-box">
                    <video @ref="_videoRef" class="stream-video" controls playsinline muted></video>
                    <div class="play-links">
                        <div><Text Type="TextElementType.Secondary">FLV</Text> <a href="@_playInfo.FlvUrl" target="_blank">@_playInfo.FlvUrl</a></div>
                        <div><Text Type="TextElementType.Secondary">HLS</Text> <a href="@_playInfo.HlsUrl" target="_blank">@_playInfo.HlsUrl</a></div>
                        <div><Text Type="TextElementType.Secondary">WS-FLV</Text> <a href="@_playInfo.WsFlvUrl" target="_blank">@_playInfo.WsFlvUrl</a></div>
                        <div><Text Type="TextElementType.Secondary">RTSP</Text> <Text Code>@_playInfo.RtspUrl</Text></div>
                    </div>
                    <Space>
                        <SpaceItem><Button Type="@ButtonType.Primary" OnClick="PlayHlsAsync">用 HLS 播放</Button></SpaceItem>
                        <SpaceItem><Button OnClick="OpenFlvExternalAsync">新窗口 FLV</Button></SpaceItem>
                    </Space>
                    <Alert Type="AlertType.Info" ShowIcon="true" Style="margin-top:12px"
                           Message="浏览器原生 video 优先 HLS；FLV/WS-FLV 建议 Jessibuca 或外部播放器。截图使用 ZLM getSnap。" />
                </div>
            }
        </Modal>

        <Drawer Title="@_viewerTitle" Visible="_viewerVisible" Width="520" OnClose="CloseViewers">
            <Button Icon="reload" Loading="_viewerLoading" OnClick="ReloadViewersAsync" Style="margin-bottom:12px">刷新观众</Button>
            <Table DataSource="@_viewers" Loading="_viewerLoading" PageSize="10" Size="@TableSize.Small" TItem="StreamViewerDto">
                <AntDesign.Column Title="会话" @bind-Field="@context.Id" Width="140" />
                <AntDesign.Column Title="客户端" @bind-Field="@context.PeerIp" Width="120" />
                <AntDesign.Column Title="端口" @bind-Field="@context.PeerPort" Width="70" />
                <AntDesign.Column Title="类型" @bind-Field="@context.TypeId" Width="100" />
                <ActionColumn Title="" Width="70">
                    <Button Type="@ButtonType.Link" Danger OnClick="@(() => KickViewerAsync(context.Id))">踢出</Button>
                </ActionColumn>
            </Table>
        </Drawer>

        <Modal Title="流截图" Visible="_snapVisible" Width="720" Footer="null" OnCancel="CloseSnap" DestroyOnClose>
            @if (!string.IsNullOrWhiteSpace(_snapUrl))
            {
                <img src="@_snapUrl" alt="snapshot" style="max-width:100%;border-radius:8px;background:#000" />
                <div style="margin-top:8px"><a href="@_snapUrl" target="_blank">在新窗口打开</a></div>
            }
        </Modal>
    </ChildContent>
</PageContainer>

@code {
    private List<MediaStreamDto> _streams = [];
    private List<StreamViewerDto> _viewers = [];
    private bool _loading;
    private bool _viewerLoading;
    private bool _playVisible;
    private bool _viewerVisible;
    private bool _snapVisible;
    private string _keyword = string.Empty;
    private string _playTitle = "播放";
    private string _viewerTitle = "观众";
    private string? _snapUrl;
    private StreamPlayInfoDto? _playInfo;
    private MediaStreamDto? _activeStream;
    private ElementReference _videoRef;

    private IEnumerable<MediaStreamDto> FilteredStreams =>
        string.IsNullOrWhiteSpace(_keyword)
            ? _streams
            : _streams.Where(x =>
                x.App.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
                || x.Stream.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
                || x.Schema.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
                || x.Vhost.Contains(_keyword, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await ServerContext.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await ServerContext.EnsureLoadedAsync();
            _streams = await Api.GetStreamsAsync(ServerContext.CurrentServerId);
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _loading = false; }
    }

    private async Task OpenPlayAsync(MediaStreamDto stream)
    {
        try
        {
            _activeStream = stream;
            _playInfo = await Api.GetPlayInfoAsync(ServerContext.CurrentServerId, stream.Vhost, stream.App, stream.Stream);
            _playTitle = $"播放 {stream.App}/{stream.Stream}";
            _playVisible = true;
        }
        catch (Exception ex) { Message.Error(ex.Message); }
    }

    private async Task PlayHlsAsync()
    {
        if (_playInfo is null) return;
        await Js.InvokeVoidAsync("MediaKitPlayer.playInVideo", _videoRef, _playInfo.HlsUrl);
    }

    private async Task OpenFlvExternalAsync()
    {
        if (_playInfo is null) return;
        await Js.InvokeVoidAsync("MediaKitPlayer.openExternal", _playInfo.FlvUrl);
    }

    private async Task ClosePlayAsync()
    {
        _playVisible = false;
        try { await Js.InvokeVoidAsync("MediaKitPlayer.stopVideo", _videoRef); } catch { }
    }

    private async Task OpenViewersAsync(MediaStreamDto stream)
    {
        _activeStream = stream;
        _viewerTitle = $"观众 {stream.App}/{stream.Stream}";
        _viewerVisible = true;
        await ReloadViewersAsync();
    }

    private void CloseViewers() => _viewerVisible = false;
    private void CloseSnap() => _snapVisible = false;

    private async Task ReloadViewersAsync()
    {
        if (_activeStream is null) return;
        _viewerLoading = true;
        try
        {
            _viewers = await Api.GetViewersAsync(ServerContext.CurrentServerId, _activeStream.Schema,
                _activeStream.Vhost, _activeStream.App, _activeStream.Stream);
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _viewerLoading = false; }
    }

    private async Task KickViewerAsync(string sessionId)
    {
        try
        {
            await Api.KickSessionAsync(ServerContext.CurrentServerId, sessionId);
            Message.Success("已踢出");
            await ReloadViewersAsync();
            await LoadAsync();
        }
        catch (Exception ex) { Message.Error(ex.Message); }
    }

    private async Task OpenSnapAsync(MediaStreamDto stream)
    {
        try
        {
            var info = await Api.GetPlayInfoAsync(ServerContext.CurrentServerId, stream.Vhost, stream.App, stream.Stream);
            _snapUrl = info?.SnapUrl + $"&_={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
            _snapVisible = true;
        }
        catch (Exception ex) { Message.Error(ex.Message); }
    }

    private async Task CloseAsync(MediaStreamDto stream)
    {
        try
        {
            await Api.CloseStreamAsync(ServerContext.CurrentServerId, stream);
            Message.Success("流已关闭");
            await LoadAsync();
        }
        catch (Exception ex) { Message.Error(ex.Message); }
    }
}
