@page "/servers"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MessageService Message

<PageContainer Title="媒体实例">
    <Content>管理独立运行的 ZLMediaKit 容器或进程。Secret 仅保存在服务端 SQLite，不会返回浏览器。</Content>
    <ChildContent>
        <Card Title="添加实例" Style="margin-bottom:16px">
            <div class="form-grid">
                <div><label class="field-label">名称</label><Input @bind-Value="_name" Placeholder="生产节点 A" /></div>
                <div><label class="field-label">HTTP API 地址</label><Input @bind-Value="_baseUrl" Placeholder="http://127.0.0.1:8080" /></div>
                <div><label class="field-label">API Secret</label><InputPassword @bind-Value="_secret" /></div>
                <div><label class="field-label">状态</label><Switch @bind-Checked="_enabled" CheckedChildren="启用" UnCheckedChildren="停用" /></div>
                <div class="wide"><Button Type="@ButtonType.Primary" Icon="plus" Loading="_saving" OnClick="CreateAsync">添加实例</Button></div>
            </div>
        </Card>
        <Card BodyStyle="padding:0">
            <Table DataSource="@_servers" Loading="_loading" HidePagination>
                <AntDesign.Column Title="名称" @bind-Field="@context.Name" />
                <AntDesign.Column Title="API 地址" @bind-Field="@context.BaseUrl" />
                <AntDesign.Column Title="启用" @bind-Field="@context.IsEnabled" Width="90" />
                <AntDesign.Column Title="创建时间" @bind-Field="@context.CreationTime" Width="190" />
                <ActionColumn Title="操作" Width="100"><Button Type="@ButtonType.Link" Danger OnClick="@(() => DeleteAsync(context.Id))">删除</Button></ActionColumn>
            </Table>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<MediaServerDto> _servers = [];
    private string _name = string.Empty; private string _baseUrl = "http://127.0.0.1:8080"; private string _secret = string.Empty; private bool _enabled = true; private bool _loading; private bool _saving;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading = true; try { _servers = await Api.GetServersAsync(); } finally { _loading = false; } }
    private async Task CreateAsync() { _saving = true; try { await Api.CreateServerAsync(new(_name, _baseUrl, _secret, _enabled)); Message.Success("媒体实例已添加"); _name = _secret = string.Empty; await LoadAsync(); } catch (Exception ex) { Message.Error(ex.Message); } finally { _saving = false; } }
    private async Task DeleteAsync(Guid id) { try { await Api.DeleteServerAsync(id); Message.Success("实例已删除"); await LoadAsync(); } catch (Exception ex) { Message.Error(ex.Message); } }
}
