@page "/push-proxies"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MediaServerContext ServerContext
@inject MessageService Message

<PageContainer Title="推流代理（转推）">
    <ExtraContent>
        <ServerSelector OnServerChanged="LoadAsync">
            <Button Icon="reload" Loading="_loading" OnClick="LoadAsync">刷新</Button>
        </ServerSelector>
    </ExtraContent>
    <Content>将本机 ZLM 上的源流转推到远端 RTSP/RTMP（addStreamPusherProxy）。</Content>
    <ChildContent>
        <Card Title="新建转推" Style="margin-bottom:16px">
            <div class="form-grid">
                <div>
                    <label class="field-label">媒体实例</label>
                    <select class="server-select" @bind="_request.MediaServerId">
                        @foreach (var server in ServerContext.Servers)
                        {
                            <option value="@server.Id">@server.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="field-label">源协议 schema</label>
                    <RadioGroup @bind-Value="_request.Schema">
                        <Radio Value="@("rtsp")">rtsp</Radio>
                        <Radio Value="@("rtmp")">rtmp</Radio>
                    </RadioGroup>
                </div>
                <div><label class="field-label">VHost</label><Input @bind-Value="_request.Vhost" /></div>
                <div>
                    <label class="field-label">应用 / 流 ID</label>
                    <InputGroup Compact>
                        <Input Style="width:40%" @bind-Value="_request.App" />
                        <Input Style="width:60%" @bind-Value="_request.Stream" />
                    </InputGroup>
                </div>
                <div class="wide"><label class="field-label">目标地址 dst_url</label><Input @bind-Value="_request.DestinationUrl" Placeholder="rtmp://host/live/stream 或 rtsp://..." /></div>
                <div><label class="field-label">备注</label><Input @bind-Value="_request.Remark" /></div>
                <div>
                    <label class="field-label">重试 / 超时（秒）</label>
                    <InputGroup Compact>
                        <AntDesign.InputNumber Style="width:50%" @bind-Value="_request.RetryCount" />
                        <AntDesign.InputNumber Style="width:50%" @bind-Value="_request.TimeoutSeconds" Min="1" />
                    </InputGroup>
                </div>
                <div>
                    <label class="field-label">RTP 方式</label>
                    <RadioGroup @bind-Value="_request.RtpType">
                        <Radio Value="0">TCP</Radio>
                        <Radio Value="1">UDP</Radio>
                    </RadioGroup>
                </div>
                <div class="wide">
                    <Space>
                        <SpaceItem><Checkbox @bind-Checked="_request.StartImmediately">立即启动</Checkbox></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Primary" Icon="plus" Loading="_saving" OnClick="CreateAsync">创建转推</Button></SpaceItem>
                    </Space>
                </div>
            </div>
        </Card>

        <Card BodyStyle="padding:0">
            <Table DataSource="@_items" Loading="_loading" PageSize="15" ScrollX="1200" TItem="PushProxyDto">
                <AntDesign.Column Title="Schema" @bind-Field="@context.Schema" Width="90" />
                <AntDesign.Column Title="VHost" @bind-Field="@context.Vhost" Width="130" />
                <AntDesign.Column Title="应用" @bind-Field="@context.App" Width="100" />
                <AntDesign.Column Title="流 ID" @bind-Field="@context.Stream" Width="140" />
                <AntDesign.Column Title="目标" @bind-Field="@context.DestinationUrl" Width="280" />
                <AntDesign.Column Title="Key" @bind-Field="@context.ProxyKey" Width="160" />
                <AntDesign.Column Title="运行" @bind-Field="@context.IsActive" Width="80" />
                <ActionColumn Title="操作" Width="220">
                    <Space>
                        <SpaceItem><Button Type="@ButtonType.Link" Disabled="@context.IsActive" OnClick="@(() => StartAsync(context.Id))">启动</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" Disabled="@(!context.IsActive)" OnClick="@(() => StopAsync(context.Id))">停止</Button></SpaceItem>
                        <SpaceItem><Button Type="@ButtonType.Link" Danger OnClick="@(() => DeleteAsync(context.Id))">删除</Button></SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<PushProxyDto> _items = [];
    private CreatePushProxyRequest _request = new();
    private bool _loading;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await ServerContext.EnsureLoadedAsync();
        ResetForm();
        await LoadAsync();
    }

    private void ResetForm()
    {
        _request = new CreatePushProxyRequest
        {
            MediaServerId = ServerContext.CurrentServerId ?? Guid.Empty,
            Schema = "rtsp",
            Vhost = "__defaultVhost__",
            App = "live",
            RetryCount = -1,
            TimeoutSeconds = 10,
            StartImmediately = true
        };
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await ServerContext.EnsureLoadedAsync();
            _request.MediaServerId = ServerContext.CurrentServerId ?? _request.MediaServerId;
            _items = await Api.GetPushProxiesAsync(ServerContext.CurrentServerId);
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _loading = false; }
    }

    private async Task CreateAsync()
    {
        if (_request.MediaServerId == Guid.Empty)
            _request.MediaServerId = ServerContext.CurrentServerId ?? Guid.Empty;
        _saving = true;
        try
        {
            await Api.CreatePushProxyAsync(_request);
            Message.Success(_request.StartImmediately ? "转推已启动" : "转推配置已保存");
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { Message.Error(ex.Message); }
        finally { _saving = false; }
    }

    private async Task StartAsync(Guid id)
    {
        try { await Api.StartPushProxyAsync(id); Message.Success("已启动"); await LoadAsync(); }
        catch (Exception ex) { Message.Error(ex.Message); }
    }

    private async Task StopAsync(Guid id)
    {
        try { await Api.StopPushProxyAsync(id); Message.Success("已停止"); await LoadAsync(); }
        catch (Exception ex) { Message.Error(ex.Message); }
    }

    private async Task DeleteAsync(Guid id)
    {
        try { await Api.DeletePushProxyAsync(id); Message.Success("已删除"); await LoadAsync(); }
        catch (Exception ex) { Message.Error(ex.Message); }
    }
}
