@page "/protocol-presets"
@namespace Apiext.MediaKit.Pages.MediaKit
@inject MediaKitApiClient Api
@inject MessageService Message

<PageContainer Title="转协议预设">
    <Content>保存常用的 ZLMediaKit ProtocolOption 参数，创建拉流代理时可直接选用。</Content>
    <ChildContent>
        <Card Title="新建预设" Style="margin-bottom:16px">
            <div class="form-grid">
                <div><label class="field-label">名称</label><Input @bind-Value="_form.Name" Placeholder="低延迟直播" /></div>
                <div><label class="field-label">MP4 切片秒数</label><AntDesign.InputNumber @bind-Value="_form.Mp4MaxSeconds" Min="0" Style="width:100%" /></div>
                <div><label class="field-label">MP4 保存路径</label><Input @bind-Value="_form.Mp4SavePath" /></div>
                <div><label class="field-label">HLS 保存路径</label><Input @bind-Value="_form.HlsSavePath" /></div>
                <div class="wide"><Space Wrap>
                    <SpaceItem><Checkbox @bind-Checked="_form.EnableAudio">音频</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.AddMuteAudio">补静音 AAC</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.EnableHls">HLS</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.EnableMp4">MP4</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.EnableRtsp">RTSP/WebRTC</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.EnableRtmp">RTMP/FLV</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.EnableTs">HTTP-TS</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.EnableFmp4">HTTP-fMP4</Checkbox></SpaceItem>
                    <SpaceItem><Checkbox @bind-Checked="_form.AutoClose">无人自动关闭</Checkbox></SpaceItem>
                </Space></div>
                <div class="wide"><Button Type="@ButtonType.Primary" Icon="save" Loading="_saving" OnClick="SaveAsync">保存预设</Button></div>
            </div>
        </Card>
        <Card BodyStyle="padding:0">
            <Table DataSource="@_items" Loading="_loading" HidePagination ScrollX="900">
                <AntDesign.Column Title="名称" @bind-Field="@context.Name" Width="180" />
                <AntDesign.Column Title="HLS" @bind-Field="@context.EnableHls" Width="70" />
                <AntDesign.Column Title="MP4" @bind-Field="@context.EnableMp4" Width="70" />
                <AntDesign.Column Title="RTSP" @bind-Field="@context.EnableRtsp" Width="70" />
                <AntDesign.Column Title="RTMP" @bind-Field="@context.EnableRtmp" Width="70" />
                <AntDesign.Column Title="TS" @bind-Field="@context.EnableTs" Width="70" />
                <AntDesign.Column Title="fMP4" @bind-Field="@context.EnableFmp4" Width="70" />
                <AntDesign.Column Title="切片秒数" @bind-Field="@context.Mp4MaxSeconds" Width="110" />
                <ActionColumn Title="操作" Width="90"><Button Type="@ButtonType.Link" Danger OnClick="@(() => DeleteAsync(context.Id))">删除</Button></ActionColumn>
            </Table>
        </Card>
    </ChildContent>
</PageContainer>

@code {
    private List<ProtocolPresetDto> _items = [];
    private SaveProtocolPresetRequest _form = new();
    private bool _loading; private bool _saving;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading = true; try { _items = await Api.GetProtocolPresetsAsync(); } finally { _loading = false; } }
    private async Task SaveAsync() { _saving = true; try { await Api.SaveProtocolPresetAsync(_form); Message.Success("预设已保存"); _form = new(); await LoadAsync(); } catch (Exception ex) { Message.Error(ex.Message); } finally { _saving = false; } }
    private async Task DeleteAsync(Guid id) { try { await Api.DeleteProtocolPresetAsync(id); Message.Success("预设已删除"); await LoadAsync(); } catch (Exception ex) { Message.Error(ex.Message); } }
}
