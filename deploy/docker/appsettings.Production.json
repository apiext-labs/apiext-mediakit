{
  // ─────────────────────────────────────────────────────────────────────
  // 宿主可编辑的配置覆盖层（挂载到容器内 /app/appsettings.Production.json）
  //
  // 优先级：docker-compose.yml 的环境变量 > 本文件 > 镜像内 appsettings.json
  //
  // 用法：只写需要覆盖的键；未写的键继续用镜像内默认值，
  //       这样升级镜像时新增的配置项会自动跟随新版本默认值。
  //
  // 生效：改完执行 `docker compose restart`（约 5 秒），不需要重建镜像。
  //
  // 注意：以下配置由 compose 环境变量注入，写在本文件里无效（环境变量优先）：
  //       App:PublicPort、ZlMediaKit:BaseUrl/PublicHost/PublicHttpPort/RtspPort/RtmpPort/Secret、
  //       Gb28181:LocalIp/MediaIp/SipPort/RtpPortMin/RtpPortMax、Recording:SourcePath、
  //       ConnectionStrings:Default
  //
  // 密钥类（Jwt:Key、PlayToken:Secret、ZlmHook:CapabilitySecret）必要时可在此追加；
  // 但改 ZlmHook:CapabilitySecret 后，必须同时重算 config.ini 里
  // 9 个 hook URL 的 ?cap=（算法见 config.ini 的 [hook] 段注释），否则所有 hook 会被 403。
  // ─────────────────────────────────────────────────────────────────────

  "Logging": {
    "LogLevel": {
      "Apiext.MediaKit.Server": "Information"
    }
  },

  // 接入密码（Gb28181:Password）与鉴权开关（Gb28181:EnableAuth）默认已在镜像内
  // appsettings.json 中打开（EnableAuth=true，设备注册必须通过 Digest 鉴权）。
  // 如需现场覆盖，在本段加回 "Password"/"EnableAuth" 即可。
  "Gb28181": {
    "SipId": "34020000002000000001",
    "SipDomain": "3402000000",
    "Realm": "3402000000",
    "Expires": 3600,
    "HeartbeatTimeout": 300,
    "Cascade": {
      "Enabled": false,
      "LocalId": "",
      "RegisterInterval": 60,
      "ReloadInterval": 5
    }
  },

  "Recording": {
    "RetentionDays": 0,
    "Schedule": "",
    "ReconcileEnabled": true
  },

  "PlayToken": {
    "TtlSeconds": 1800,
    "GraceSeconds": 43200,
    "BindClientIp": false
  }
}
