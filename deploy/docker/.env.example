# 复制为 deploy/docker/.env 后按实际环境修改（推荐直接运行 quickstart 脚本自动生成）
# PUBLIC_HOST 必须是浏览器/设备可达的「宿主机」IP，不是 127.0.0.1、也不是容器 IP
PUBLIC_HOST=192.168.1.100

# 宿主机端口（默认均为非常用端口，避免与其他软件冲突；改这里 compose 会同步跟随）
# 注意：SIP 端口改了以后，国标设备端的「平台 SIP 端口」也要同步改
APP_PORT=28080
SIP_PORT=28060
ZLM_HTTP_PORT=28180
RTSP_PORT=28554
RTMP_PORT=28335

TZ=Asia/Shanghai

# 基础镜像源（默认官方 mcr.microsoft.com；国内网络直连很慢时改用加速源）
# DOTNET_SDK_IMAGE=mcr.m.daocloud.io/dotnet/sdk:10.0
# DOTNET_RUNTIME_IMAGE=mcr.m.daocloud.io/dotnet/aspnet:10.0
# ZLM_IMAGE=zlmediakit/zlmediakit:master
